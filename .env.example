# ==============================================================================
# Service Hosts & Ports
# ==============================================================================
REST_SERVER_HOST=127.0.0.1
REST_SERVER_PORT=8001

GRAPHQL_SERVER_HOST=127.0.0.1
GRAPHQL_SERVER_PORT=8002

MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8005

# ==============================================================================
# Internal Service URLs
# ==============================================================================
REST_API_URL=http://127.0.0.1:8001
GRAPHQL_URL=http://127.0.0.1:8002/graphql
MCP_SERVER_URL=http://0.0.0.0:8005/mcp

# ==============================================================================
# External Public APIs (Weather & Music)
# ==============================================================================
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
ITUNES_SEARCH_URL=https://itunes.apple.com/search

# ==============================================================================
# Keycloak Identity Provider
# ==============================================================================
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=geoagent
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# ==============================================================================
# Distributed Tracing & Observability (OpenTelemetry / Jaeger)
# ==============================================================================
JAEGER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
